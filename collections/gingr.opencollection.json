          },
          "http": {
            "method": "GET",
            "url": "https://api.gingr.io/v1/config/lodgings"
          },
          "docs": "Lists the facility's configured lodgings (kennels/runs/suites)."
        },
        {
          "info": {
            "name": "List locations.",
