          },
          "http": {
            "method": "POST",
            "url": "https://api.gingr.io/v1/invoices/:invoiceId/refund-items",
            "params": [
              {
                "name": "invoiceId",
                "value": "",
                "type": "path",
                "description": "The invoiceId."
              }
            ],
            "body": {
              "type": "json",
              "data": "{\"data\": {\"attributes\": {\"itemIds\": [0], \"refundReasonId\": 0}}}"
            }
          },
          "docs": "Refunds specific line items on an invoice."
        },
        {
          "info": {
            "name": "Charge a card on file.",
