    {
      "info": {
        "name": "Waitlist",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Move a booking to the waitlist.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gingr.io/v1/bookings/:bookingId/wait-list",
            "params": [
              {
                "name": "bookingId",
                "value": "",
                "type": "path",
                "description": "The bookingId."
