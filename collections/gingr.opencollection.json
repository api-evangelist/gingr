          },
          "http": {
            "method": "GET",
            "url": "https://api.gingr.io/v1/config/service-types/:serviceTypeId",
            "params": [
              {
                "name": "serviceTypeId",
                "value": "",
                "type": "path",
                "description": "The serviceTypeId."
              }
            ]
          },
          "docs": "Retrieves detailed information for a specific service type."
        },
        {
          "info": {
            "name": "List booking types.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gingr.io/v1/config/booking-types"
          },
          "docs": "Lists the facility's configured booking types."
        },
        {
          "info": {
            "name": "List lodgings.",
